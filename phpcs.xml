<?xml version="1.0"?>
<ruleset name="Zenith Framework">
    <description>Enforce PSR-12 coding style for the Zenith Framework core.</description>

    <rule ref="PSR12" />

    <file>src</file>
    <file>bootstrap</file>
    <file>bin</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="basepath" value="." />
    <arg name="colors" />
    <arg value="sp" />
</ruleset>
