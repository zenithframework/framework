{
  "name": "zenithframework/framework",
  "description": "The minimal backend foundation of the Zenith Framework.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Zenith\\\\": "src/Zenith/"
    }
  },
  "scripts": {
    "lint:style": "phpcs",
    "fix:style": "phpcbf"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
